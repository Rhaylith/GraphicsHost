# Generates GraphicsHost.Core/graph/TipsData.h from docs/workflow-node-reference.md (sections C and O).
#   awk -f tools/gen_tips.awk docs/workflow-node-reference.md > GraphicsHost.Core/graph/TipsData.h
# The [unit][tips] test fails when the header and the document disagree, so edit the document and regenerate.

BEGIN {
    print "// Generated by tools/gen_tips.awk from docs/workflow-node-reference.md. Do not edit: change the document and run the script."
    print "#pragma once"
    print ""
    print "#include \"graph/Tips.h\""
    print ""
    print "namespace gh::graph::tips {"
    print ""
    section = ""
}

/^## C\. / { section = "C"; print "// ---- C. common tooltips"; next }
/^## O\. / { section = "O"; next }
/^## N[0-9]/ || /^## S\./ { if (open) { print "};"; print ""; open = 0 } section = ""; next }

section == "C" && /^\| `C\./ {
    line = $0
    start = index(line, "`C.") + 3
    rest = substr(line, start)
    key = substr(rest, 1, index(rest, "`") - 1)
    text = substr(rest, index(rest, "` | ") + 4)
    sub(/ \|$/, "", text)
    printf "inline constexpr const char* %s = QT_TRANSLATE_NOOP(\"tips\", R\"tip(%s)tip\");\n", key, text
    keys[++nkeys] = key
    next
}

section == "O" && /^### O\./ {
    if (nkeys > 0 && !listed) {
        print ""
        print "inline constexpr CommonTip allCommon[] = {"
        for (i = 1; i <= nkeys; i++) printf "    {\"%s\", %s},\n", keys[i], keys[i]
        print "};"
        print ""
        listed = 1
    }
    if (open) { print "};"; print "" }
    name = $2
    sub(/^O\./, "", name)
    printf "inline constexpr OptionTip %sOptions[] = {\n", name
    names[++ntables] = name
    open = 1
    next
}

section == "O" && open && /^\| / {
    if ($0 ~ /^\| Option \|/) next
    line = $0
    sub(/^\| /, "", line)
    option = substr(line, 1, index(line, " | ") - 1)
    text = substr(line, index(line, " | ") + 3)
    sub(/ \|$/, "", text)
    # a row such as "seeds 2 / seeds 3" describes two options with one text
    n = split(option, parts, " / ")
    for (p = 1; p <= n; p++)
        printf "    {\"%s\", QT_TRANSLATE_NOOP(\"tips\", R\"tip(%s)tip\")},\n", parts[p], text
    next
}

END {
    if (open) { print "};"; print "" }
    print "inline constexpr OptionTable allOptionTables[] = {"
    for (i = 1; i <= ntables; i++) printf "    {\"%s\", %sOptions},\n", names[i], names[i]
    print "};"
    print ""
    print "}  // namespace gh::graph::tips"
}
