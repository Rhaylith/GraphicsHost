<Project>
  <!--
    Common body of the runtime DLL projects (sd-cpu-avx2, sd-vulkan). Each project sets
    RuntimeId, RuntimeBackend, GgmlProject and GgmlProjectGuid before importing this file.
    Runtime DLLs link ggml and stable-diffusion statically, so they need no other DLLs besides the system Vulkan loader.
  -->
  <Import Project="$(GhProps)" />
  <PropertyGroup>
    <OutDir>$(RepoRoot)build\bin\$(Platform)\$(Configuration)\runtimes\</OutDir>
    <TargetName>sd-$(RuntimeId)</TargetName>
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(Sdcpp)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GH_RUNTIME_ID="$(RuntimeId)";GH_RUNTIME_BACKEND="$(RuntimeBackend)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <!-- gh_components.cpp looks inside the engine: it gets the engine's include paths, defines and language standard -->
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)gh_components.cpp">
      <AdditionalIncludeDirectories>$(Sdcpp)src;$(Sdcpp)src\core;$(Sdcpp)thirdparty;$(Sdcpp)ggml\include;$(Sdcpp)ggml\src;$(RepoRoot)ggml\generated;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GGML_MAX_NAME=160;GGML_SCHED_MAX_COPIES=4;GGML_USE_CPU;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/wd4244 /wd4267 /wd4305 /wd4996 /wd4068 /wd4005 /wd4018 /wd4101 /wd4146 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)gh_runtime.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)gh_runtime.h" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)ggml\$(GgmlProject)">
      <Project>$(GgmlProjectGuid)</Project>
    </ProjectReference>
    <ProjectReference Include="$(RepoRoot)stable-diffusion\stable-diffusion.vcxproj">
      <Project>{7B3D1E0A-5C2F-4E7A-9A11-0F6E2D4C8A02}</Project>
    </ProjectReference>
  </ItemGroup>
</Project>
