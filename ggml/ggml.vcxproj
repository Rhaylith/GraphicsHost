<?xml version="1.0" encoding="utf-8"?>
<!--
  ggml as one static library: ggml-base + the backend registry + the x86 CPU backend.
  Replaces the CMake targets ggml-base, ggml and ggml-cpu of the pinned stable-diffusion.cpp submodule.
  GgmlCpuVariant selects the instruction set: avx2 (default) or noavx.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{7B3D1E0A-5C2F-4E7A-9A11-0F6E2D4C8A01}</ProjectGuid>
    <RootNamespace>ggml</RootNamespace>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <GgmlCpuVariant Condition="'$(GgmlCpuVariant)'==''">avx2</GgmlCpuVariant>
    <GgmlSrc>$(Sdcpp)ggml\</GgmlSrc>
    <!-- same-named sources get unique object names in the UniqueObjectNames target below -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB8027</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <!-- Vulkan variant (msbuild /p:GgmlVulkan=true): separate library name and object folder, so both variants coexist. -->
  <PropertyGroup Condition="'$(GgmlVulkan)'=='true'">
    <TargetName>ggml-vulkan</TargetName>
    <IntDir>$(RepoRoot)build\obj\ggml-vulkan\$(Platform)\$(Configuration)\</IntDir>
    <VkSrc>$(GgmlSrc)src\ggml-vulkan\</VkSrc>
    <VkGenDir>$(IntDir)vulkan\</VkGenDir>
    <VkGenExe>$(RepoRoot)build\tools\vulkan-shaders-gen.exe</VkGenExe>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(GgmlVulkan)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(VkGenDir);$(VcpkgInstalled)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GGML_USE_VULKAN;GGML_VULKAN_COOPMAT_GLSLC_SUPPORT;GGML_VULKAN_COOPMAT2_GLSLC_SUPPORT;GGML_VULKAN_COOPMAT2_DECODE_VECTOR_GLSLC_SUPPORT;GGML_VULKAN_INTEGER_DOT_GLSLC_SUPPORT;GGML_VULKAN_BFLOAT16_GLSLC_SUPPORT;GGML_VULKAN_FLOAT_E2M1_GLSLC_SUPPORT;GGML_VULKAN_FLOAT_E4M3_GLSLC_SUPPORT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <AdditionalOptions>/utf-8 /bigobj /experimental:c11atomics /wd4244 /wd4267 /wd4305 /wd4996 /wd4068 /wd4005 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(GgmlSrc)include;$(GgmlSrc)src;$(GgmlSrc)src\ggml-cpu;$(MSBuildThisFileDirectory)generated;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GGML_MAX_NAME=160;GGML_SCHED_MAX_COPIES=4;_CRT_SECURE_NO_WARNINGS;GGML_USE_CPU;GGML_USE_LLAMAFILE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(GgmlCpuVariant)'=='avx2'">
    <ClCompile>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
      <PreprocessorDefinitions>GGML_AVX2;GGML_FMA;GGML_F16C;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- /p:GgmlVulkanDebug=true prints the Vulkan backend's debug log (instance creation errors are otherwise swallowed). -->
  <ItemDefinitionGroup Condition="'$(GgmlVulkan)'=='true' And '$(GgmlVulkanDebug)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>GGML_VULKAN_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup Label="ggml-base and backend registry">
    <ClCompile Include="$(GgmlSrc)src\ggml.c" />
    <ClCompile Include="$(GgmlSrc)src\ggml.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-alloc.c" />
    <ClCompile Include="$(GgmlSrc)src\ggml-backend.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-backend-meta.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-backend-dl.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-backend-reg.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-opt.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-threading.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-quants.c" />
    <ClCompile Include="$(GgmlSrc)src\gguf.cpp" />
  </ItemGroup>
  <ItemGroup Label="CPU backend (x86)">
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\ggml-cpu.c" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\ggml-cpu.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\repack.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\hbm.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\quants.c" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\traits.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\amx\amx.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\amx\mmq.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\tiled\tiled.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\tiled\tiled-kernel.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\binary-ops.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\unary-ops.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\vec.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\ops.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\llamafile\sgemm.cpp" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\arch\x86\quants.c" />
    <ClCompile Include="$(GgmlSrc)src\ggml-cpu\arch\x86\repack.cpp" />
  </ItemGroup>
  <ItemGroup Label="Vulkan backend" Condition="'$(GgmlVulkan)'=='true'">
    <ClCompile Include="$(VkSrc)ggml-vulkan.cpp" />
    <ClCompile Include="$(VkSrc)ggml-vulkan-buffers.cpp" />
    <ClCompile Include="$(VkSrc)ggml-vulkan-debug.cpp" />
    <VkShader Include="$(VkSrc)vulkan-shaders\*.comp" />
    <!-- one generated .cpp per shader; they are created by the GenerateVulkanShaders target before compiling -->
    <ClCompile Include="@(VkShader->'$(VkGenDir)%(Filename)%(Extension).cpp')" />
    <ProjectReference Include="vulkan-shaders-gen.vcxproj">
      <Project>{7B3D1E0A-5C2F-4E7A-9A11-0F6E2D4C8A04}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <SetConfiguration>Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!--
    Shader generation (what CMake does with ExternalProject + add_custom_command):
    1. vulkan-shaders-gen called without a source argument writes ggml-vulkan-shaders.hpp;
    2. for every .comp it compiles all variants with glslc and writes <name>.comp.cpp.
    Step 2 is incremental: only shaders newer than their output are regenerated.
  -->
  <Target Name="GenerateVulkanShadersHeader" BeforeTargets="ClCompile" Condition="'$(GgmlVulkan)'=='true'"
          Inputs="$(VkGenExe)" Outputs="$(VkGenDir)ggml-vulkan-shaders.hpp">
    <MakeDir Directories="$(VkGenDir)" />
    <Exec Command="&quot;$(VkGenExe)&quot; --output-dir &quot;$(VkGenDir)vulkan-shaders.spv&quot; --target-hpp &quot;$(VkGenDir)ggml-vulkan-shaders.hpp&quot;" />
  </Target>
  <Target Name="GenerateVulkanShaders" BeforeTargets="ClCompile" DependsOnTargets="GenerateVulkanShadersHeader" Condition="'$(GgmlVulkan)'=='true'"
          Inputs="@(VkShader);$(VkGenExe)" Outputs="@(VkShader->'$(VkGenDir)%(Filename)%(Extension).cpp')">
    <Exec Command="&quot;$(VkGenExe)&quot; --glslc &quot;$(Glslc)&quot; --source &quot;%(VkShader.FullPath)&quot; --output-dir &quot;$(VkGenDir)vulkan-shaders.spv&quot; --target-hpp &quot;$(VkGenDir)ggml-vulkan-shaders.hpp&quot; --target-cpp &quot;$(VkGenDir)%(VkShader.Filename)%(VkShader.Extension).cpp&quot;" />
  </Target>
  <!-- Different folders hold same-named sources (quants.c, repack.cpp, ggml.c vs ggml.cpp): make every object name unique. -->
  <Target Name="UniqueObjectNames" BeforeTargets="SelectClCompile">
    <ItemGroup>
      <ClCompile>
        <ObjectFileName>$(IntDir)$([System.String]::Copy('%(FullPath)').Replace('$(GgmlSrc)src\','').Replace('$(IntDir)','').Replace(':','').Replace('\','_')).obj</ObjectFileName>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
