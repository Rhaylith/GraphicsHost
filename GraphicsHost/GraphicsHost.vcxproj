  <!-- translations\*.ts (made with lupdate, see translations\README.md) become translations\*.qm next to the exe -->
  <Target Name="CompileTranslations" AfterTargets="Build" Condition="Exists('$(QtToolsDir)lrelease.exe')">
    <ItemGroup>
      <TsFile Include="$(MSBuildProjectDirectory)\translations\*.ts" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)translations" />
    <Exec Command="&quot;$(QtToolsDir)lrelease.exe&quot; -silent &quot;%(TsFile.FullPath)&quot; -qm &quot;$(OutDir)translations\%(TsFile.Filename).qm&quot;" Condition="'@(TsFile)' != ''" />
  </Target>
