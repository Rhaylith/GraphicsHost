GraphicsHost/native/sd-cpu/
GraphicsHost/native/sd-vulkan/

# GraphicsHost generated images
GraphicsHost/outputs/

# GraphicsHost per-user runtime settings
GraphicsHost/settings.local.json

# GraphicsHost window state and WebView2 profile
GraphicsHost/window.json
GraphicsHost/webview2/
