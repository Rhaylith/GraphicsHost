<?xml version="1.0" encoding="utf-8"?>
<!--
  GraphicsHost.Core: everything that is not UI. Settings, logging, hardware detection, the runtime loader and (from
  later phases) the model library, downloads, job queue and HTTP server. Static library used by the app and the tests.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{7B3D1E0A-5C2F-4E7A-9A11-0F6E2D4C8A09}</ProjectGuid>
    <RootNamespace>GraphicsHostCore</RootNamespace>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(GhProps)" />
  <PropertyGroup>
    <TargetName>GraphicsHost.Core</TargetName>
    <CoreDir>$(MSBuildThisFileDirectory)</CoreDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(CoreDir);$(RepoRoot)runtime;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>SPDLOG_SHARED_LIB;SPDLOG_COMPILED_LIB;SPDLOG_FMT_EXTERNAL;FMT_SHARED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="core\**\*.cpp" />
    <ClCompile Include="engine\**\*.cpp" />
    <ClCompile Include="cli\**\*.cpp" />
    <ClCompile Include="server\**\*.cpp" />
    <ClInclude Include="server\**\*.h" />
    <ClCompile Include="net\**\*.cpp" />
    <ClInclude Include="net\**\*.h" />
    <ClCompile Include="models\**\*.cpp" />
    <ClInclude Include="models\**\*.h" />
    <ClCompile Include="presets\**\*.cpp" />
    <ClInclude Include="presets\**\*.h" />
    <ClCompile Include="gallery\**\*.cpp" />
    <ClInclude Include="gallery\**\*.h" />
    <ClCompile Include="host\**\*.cpp" />
    <ClCompile Include="sampling\**\*.cpp" />
    <ClInclude Include="sampling\**\*.h" />
    <ClCompile Include="tensor\**\*.cpp" />
    <ClInclude Include="tensor\**\*.h" />
    <ClCompile Include="graph\**\*.cpp" />
    <ClInclude Include="graph\**\*.h" />
    <ClCompile Include="nodes\**\*.cpp" />
    <ClInclude Include="nodes\**\*.h" />
    <ClInclude Include="host\**\*.h" />
    <ClInclude Include="core\**\*.h" />
    <ClInclude Include="engine\**\*.h" />
    <ClInclude Include="cli\**\*.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
